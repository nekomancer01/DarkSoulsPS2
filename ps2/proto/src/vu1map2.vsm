	itof0.xy VF13,VF13             	lq VF17,2(VI03)
	itof0.xyz VF14,VF14            	lq VF18,5(VI03)
	mulax ACC,VF01,VF11x           	lq VF19,8(VI03)
	madday ACC,VF02,VF11y          	sq VF10,0(VI08)
	maddaz ACC,VF03,VF11z          	sq VF17,2(VI08)
	maddw VF20,VF04,VF00w          	sq VF18,5(VI08)
