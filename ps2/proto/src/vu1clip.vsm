; VU1 microprogram (generated by tools/vu1/gen.py clip, do not edit): map batches that cross the near plane or the
; guard band (VU1_CLIP). Same input and constants as vu1map2.vsm (list batches, <= 32 triangles; vu1_add_ex
; splits) or, from the entry VU1Clip_Idx, as vu1mapi.vsm (indexed batches with header + vertices + triangle stream
; <= 336 qwords; vu1_add_idx): the indexed pass 1 gathers each triangle's corners through its index qword.
; Pass 1: vu1map2's software-pipelined loop over every triangle: unflagged triangles are drawn there (one GIF packet
; each from output slot VI08 = 994 / 1004); a triangle with a flagged corner is kicked with ADC (not drawn) and
; its address (indexed: its index qword's) appended to a list at TOPS+428 (branch-free: the list pointer advances
; by the CLIP test's 0 / 1).
; Pass 2, per listed triangle: the three corners again (view space, st K, colour) into polygon buffer A at
; TOPS+336, CLIPs, then the clip core: trivial reject, Sutherland-Hodgman against the planes at 1014 that some
; corner is outside of (after the near plane the corners are CLIPped again: CLIP compares with |z|), projection,
; fan, back faces dropped, one GIF packet per triangle (B at TOPS+363, projected at TOPS+390). A cut edge's
; new corner is interpolated from its inside end, so two triangles sharing the edge get the same point.

; pass 1 loop: 79 cycles per triangle (indexed: 91) in the tools/vu1 timing model

		.vu
		.align 4
		.global VU1Clip_CodeStart
		.global VU1Clip_Idx
		.global VU1Clip_CodeEnd
VU1Clip_CodeStart:
	NOP                            	lq VF01,0(VI00)
	NOP                            	lq VF02,1(VI00)
	NOP                            	lq VF03,2(VI00)
	NOP                            	lq VF04,3(VI00)
	NOP                            	lq VF05,4(VI00)
	NOP                            	lq VF06,5(VI00)
	NOP                            	lq VF07,6(VI00)
	NOP                            	lq VF08,7(VI00)
	NOP                            	xtop VI02
	NOP                            	iaddiu VI01,VI00,1004
	NOP                            	NOP
	NOP                            	ilw.x VI04,0(VI02)
	NOP                            	ilw.y VI05,0(VI02)
	NOP                            	lq VF09,0(VI02)
	NOP                            	lq VF19,1(VI02)
	NOP                            	lq VF10,6(VI02)
	NOP                            	iaddiu VI10,VI02,2
	mulax ACC,VF01,VF19x           	xgkick VI10
	madday ACC,VF02,VF19y          	iaddiu VI03,VI02,7
	maddaz ACC,VF03,VF19z          	iaddiu VI09,VI00,0x7fff
	maddw VF04,VF04,VF00w          	iaddiu VI09,VI09,1
	mulw VF01,VF01,VF19w           	iaddiu VI06,VI00,1998
	mulw VF02,VF02,VF19w           	iaddiu VI07,VI02,428
	mulw VF03,VF03,VF19w           	iaddiu VI10,VI00,0
	NOP                            	isw.x VI10,427(VI02)
	NOP                            	ibeq VI08,VI01,c2Pass1
	NOP                            	NOP
	NOP                            	iaddiu VI08,VI00,994
c2Pass1:
	NOP                            	lq VF11,0(VI03)
	NOP                            	lq VF12,3(VI03)
	NOP                            	lq VF13,1(VI03)
	NOP                            	lq VF14,6(VI03)
	itof0.xyz VF11,VF11            	lq VF15,4(VI03)
	itof0.xyz VF12,VF12            	lq VF16,7(VI03)
	itof0.xy VF13,VF13             	lq VF17,2(VI03)
