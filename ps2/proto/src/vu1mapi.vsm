	madd.xyz VF23,VF28,VF05        	NOP
	mulq.xy VF16,VF16,Q            	NOP
	mulq.z VF16,VF09,Q             	NOP
	ftoi4 VF29,VF21                	NOP
	ftoi4 VF30,VF22                	NOP
	ftoi4 VF31,VF23                	NOP
	NOP                            	sq VF16,7(VI03)
