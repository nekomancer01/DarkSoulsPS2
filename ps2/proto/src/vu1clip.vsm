	clipw.xyz VF29xyz,VF21w        	NOP
	opmula.xyz ACC,VF17,VF31       	NOP
	clipw.xyz VF11xyz,VF22w        	NOP
	opmsub.xyz VF18,VF31,VF17      	NOP
	itof0.xy VF16,VF16             	NOP
	mini.w VF25,VF25,VF08          	NOP
	mini.w VF26,VF26,VF08          	fcand VI01,262143
	ftoi4 VF19,VF24                	fmand VI10,VI05
