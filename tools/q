#!/bin/bash
# Usage: tools/q [-m GB] <command...>  — run a heavy job through the project job queue.
# Every heavy job (make / exporters, PCSX2 tests, Ghidra, whole-game scans) goes through here (user request
# 2026-10-31, after three OOM kills of the whole Claude app). Jobs run side by side as long as their memory caps fit:
# a job starts when the caps of the running jobs plus its own stay within BUDGET GB and the host has GB free. Each job
# gets an address-space cap so a runaway fails with MemoryError instead of filling swap. `make` jobs also take
# .build.lock, so builds (which rewrite build/) never overlap each other. A q started inside another q job or inside
# `flock .build.lock -c ...` does not wait again (that would deadlock on its parent).
#   -m GB   memory cap for this job (default 10; also its reservation against BUDGET)
# Env: DSR_Q_BUDGET (default 20 GB of the 31 GB host: leaves room for the desktop, browser, RuneLite and Claude).
ROOT=$(cd "$(dirname "$0")/.." && pwd)
GB=10
Q_BUDGET=${DSR_Q_BUDGET:-20}
[ "$1" = "-m" ] && { GB=$2; shift 2; }
[ $# -gt 0 ] || { echo "usage: $0 [-m GB] command..."; exit 2; }
held() {  # an ancestor already holds the queue: DSR_Q_HELD, or a `flock ... .build.lock` parent
    [ -n "$DSR_Q_HELD" ] && return 0
    local p=$PPID
    while [ "$p" -gt 1 ]; do
        tr '\0' ' ' < /proc/$p/cmdline 2>/dev/null | grep -q 'flock.*\.build\.lock' && return 0
        p=$(awk '/^PPid:/{print $2}' /proc/$p/status 2>/dev/null || echo 1)
    done
    return 1
}
if held; then
    # a nested cap can't exceed the outer one (prlimit fails raising it): clamp to the current limit
    CUR=$(ulimit -v); [ "$CUR" != unlimited ] && [ $((GB << 20)) -gt "$CUR" ] && GB=$((CUR >> 20))
    exec prlimit --as=$((GB << 30)) -- "$@"
fi
RES=/tmp/dsr-q; mkdir -p "$RES"
T0=$(date +%s)
echo "[q] waiting (cap ${GB} GB, budget ${Q_BUDGET} GB): $*" >&2
# a build rewrites build/: only one at a time (fd 8, the lock shared with `flock .build.lock` users)
case " $* " in *" make "*|*"/make "*|" make"*) exec 8>"$ROOT/.build.lock"; flock 8 ;; esac
# reserve GB against the budget; the mutex (fd 9) makes check + reserve atomic between queued jobs
exec 9>"$RES/.mutex"
for i in $(seq 1800); do
    flock 9
    USED=0
    for f in "$RES"/*; do
        [ -e "$f" ] || continue
        p=${f##*/}; p=${p%%.*}
        if [ -d "/proc/$p" ]; then USED=$((USED + ${f##*.})); else rm -f "$f"; fi
    done
    AV=$(awk '/MemAvailable/{print int($2/1048576)}' /proc/meminfo)
    # admit when it fits the budget and the host has room; a job bigger than the budget runs alone
    if { [ $((USED + GB)) -le "$Q_BUDGET" ] || [ "$USED" -eq 0 ]; } && [ "$AV" -ge "$GB" -o "$USED" -eq 0 ]; then
        touch "$RES/$$.$GB"; flock -u 9; break
    fi
    flock -u 9; sleep 2
done
[ -e "$RES/$$.$GB" ] || touch "$RES/$$.$GB"  # waited 1 h: run anyway, the cap and memwatch still guard it
echo "[q] start after $(( $(date +%s) - T0 )) s (${AV} GB free, ${USED} GB reserved, cap ${GB} GB): $*" >&2
echo "$(date '+%F %T') start pid $$ cap ${GB}G (reserved ${USED}G): $*" >> "$ROOT/notes/jobq.log"
# the job gets no copy of the lock fds: a daemon it starts (e.g. Xvfb :99 from pcsx2-run.sh) would otherwise hold
# them after the job ends (deadlock 2026-10-31 11:47)
DSR_Q_HELD=1 prlimit --as=$((GB << 30)) -- "$@" 8>&- 9>&-
RC=$?
rm -f "$RES/$$.$GB"
echo "$(date '+%F %T') end   pid $$ rc $RC after $(( $(date +%s) - T0 )) s" >> "$ROOT/notes/jobq.log"
exit $RC
