# Everything generated from the game goes to build/ (see config.mk, notes/oss/audit.md). Nothing game-derived is tracked.
/build/
/config.local.mk
.build.lock
.job.lock
*.lock
!Cargo.lock

# Game files and anything exported from them, wherever a tool might drop them
*.exe
*.dcx
*.bnd
*.bdt
*.bhd
*.hkx
*.hkxbdt
*.hkxbhd
*.flver
*.tpf
*.msb
*.esd
*.fmg
*.pak
*.lua0
*.luabnd
*.sqlite
*.iso

# ps2/proto: build outputs (old in-tree locations and the convenience links into build/)
/ps2/proto/proto*.elf
/ps2/proto/data
/ps2/proto/src/*.bin
/ps2/proto/src/*.bin.static
/ps2/proto/src/player_data.h
/ps2/proto/src/combat_data.h
/ps2/proto/src/c[0-9]*/
/ps2/proto/src/m[0-9]*/
/ps2/proto/obj-gprof/
/ps2/proto/--help
*.o
*.d
.cflags
*.elf
*.so
gmon.out
/ps2/proto_k14/
/ps2/proto_mc/
/ps2/vu1test/zbyszek.raw

# Exe research data (decompiled code, dumps, databases): facts go into notes, never the dumps themselves
/fndb/work/
/fndb/*.log
/fndb/ollama.*
/fndb/rates.json
/fndb/test/
/ghidra/project
/ghidra/logs/
/rea/
/tools/exe-work/
/tools/exe-dearxan/target/
/data/*.esd.txt
/data/ref/
/jp/translate.out

# Third-party clones (fetched separately, see README)
/ext/
/tools/ext/
/tools/vgmstream/
/tools/liq/
/tools/lz4hc/build/

# Screenshots / renders of game content, milestone captures, user screenshots
/notes/milestones/
*.png
*.webp
*.jpg
*.jpeg
*.gif
*.mp4
*.bmp

# Logs, scratch, environments
*.log
/notes/enemy/aitest/aitest
/tools/scratch/
.venv/
.venv-*/
__pycache__/
*.pyc
