; VU1 microprogram (generated by tools/vu1/gen.py clip, do not edit): map batches that cross the near plane or the
; guard band (F4; replaces the EE clip pass map.c draw_clipped). Same input as vu1map.vsm (R3: header 0 {tris, cull,
; st scale K, edge fog slope a2 (ignored: clip batches are near the camera, never in map.c's edge band)}, 1 {origin xyz, step}, 2 A+D tag (EOP set), 3-5 TEX0 / TEX1 / TEST, 6 PRIM tag with NLOOP 3 + EOP,
; vertices at 7: s16 pos / u16 st / u8 colour, 3 qw each); batches of <= 32 triangles (vu1_add_ex splits).
; Per triangle: view-space vertices (P, st K, colour as floats) into polygon buffer A at TOPS+296; CLIP of (x F/G,
; y F/G, z - 2 near) against z (constants 6 / 7 as for vu1map.vsm); all three outside one plane: dropped; none
; flagged: drawn as is; otherwise Sutherland-Hodgman against the 5 planes at 1014 (near: z >= near; guard band:
; |x| <= z G / F, |y| <= z G / Fy), A <-> B at TOPS+323; the polygon (<= 8 vertices) is projected into TOPS+350
; (STQ, RGBAQ, XYZF2, screen float) and drawn as a fan; back faces (cull mask on the screen cross product) are not
; emitted at all. Every emitted triangle is one GIF packet kicked from output slot VI08 (994 / 1004, shared with
; the map program: a slot is rewritten only after the other one's kick, which waits for this one).
; Hand written, unpipelined (only near / guard-band batches run it); MAC flags are read 4 cycles after their op.

		.vu
		.align 4
		.global VU1Clip_CodeStart
		.global VU1Clip_CodeEnd
VU1Clip_CodeStart:
	NOP                            	lq VF01,0(VI00)
	NOP                            	lq VF02,1(VI00)
	NOP                            	lq VF03,2(VI00)
	NOP                            	lq VF04,3(VI00)
	NOP                            	lq VF05,4(VI00)
	NOP                            	lq VF06,5(VI00)
	NOP                            	lq VF07,6(VI00)
	NOP                            	lq VF08,7(VI00)
	NOP                            	xtop VI02
	NOP                            	iaddiu VI01,VI00,1004
	NOP                            	ilw.x VI04,0(VI02)
	NOP                            	ilw.y VI05,0(VI02)
	NOP                            	lq VF09,0(VI02)
	NOP                            	lq VF19,1(VI02)
	NOP                            	lq VF28,6(VI02)
	NOP                            	iaddiu VI10,VI02,2
	mulax ACC,VF01,VF19x           	xgkick VI10
	madday ACC,VF02,VF19y          	iaddiu VI03,VI02,7
	maddaz ACC,VF03,VF19z          	iaddiu VI09,VI00,0x80
	maddw VF04,VF04,VF00w          	NOP
	mulw VF01,VF01,VF19w           	NOP
	mulw VF02,VF02,VF19w           	NOP
	mulw VF03,VF03,VF19w           	NOP
	addw VF29,VF00,VF00w           	ibeq VI08,VI01,clipTri
	NOP                            	NOP
	NOP                            	iaddiu VI08,VI00,994
clipTri:
	NOP                            	lq VF10,0(VI03)
	NOP                            	lq VF11,1(VI03)
	itof0.xyz VF10,VF10            	lq VF12,2(VI03)
	itof0.xy VF11,VF11             	NOP
	mulax ACC,VF01,VF10x           	NOP
	madday ACC,VF02,VF10y          	NOP
	maddaz ACC,VF03,VF10z          	NOP
	maddw VF13,VF04,VF00w          	NOP
	itof0 VF12,VF12                	NOP
	addz.z VF11,VF00,VF09z         	NOP
	max.w VF13,VF00,VF00           	NOP
	mul.xyz VF16,VF13,VF07         	NOP
	mulz.w VF17,VF00,VF13z         	NOP
	add.xyz VF16,VF16,VF08         	sq VF11,297(VI02)
	clipw.xyz VF16xyz,VF17w        	sq VF12,298(VI02)
	NOP                            	sq VF13,296(VI02)
	NOP                            	lq VF10,3(VI03)
	NOP                            	lq VF11,4(VI03)
	itof0.xyz VF10,VF10            	lq VF12,5(VI03)
	itof0.xy VF11,VF11             	NOP
	mulax ACC,VF01,VF10x           	NOP
	madday ACC,VF02,VF10y          	NOP
	maddaz ACC,VF03,VF10z          	NOP
	maddw VF13,VF04,VF00w          	NOP
	itof0 VF12,VF12                	NOP
	addz.z VF11,VF00,VF09z         	NOP
	max.w VF13,VF00,VF00           	NOP
	mul.xyz VF16,VF13,VF07         	NOP
	mulz.w VF17,VF00,VF13z         	NOP
	add.xyz VF16,VF16,VF08         	sq VF11,300(VI02)
	clipw.xyz VF16xyz,VF17w        	sq VF12,301(VI02)
	NOP                            	sq VF13,299(VI02)
	NOP                            	lq VF10,6(VI03)
	NOP                            	lq VF11,7(VI03)
	itof0.xyz VF10,VF10            	lq VF12,8(VI03)
	itof0.xy VF11,VF11             	NOP
	mulax ACC,VF01,VF10x           	NOP
	madday ACC,VF02,VF10y          	NOP
	maddaz ACC,VF03,VF10z          	NOP
	maddw VF13,VF04,VF00w          	NOP
	itof0 VF12,VF12                	NOP
	addz.z VF11,VF00,VF09z         	NOP
	max.w VF13,VF00,VF00           	NOP
	mul.xyz VF16,VF13,VF07         	NOP
	mulz.w VF17,VF00,VF13z         	NOP
	add.xyz VF16,VF16,VF08         	sq VF11,303(VI02)
	clipw.xyz VF16xyz,VF17w        	sq VF12,304(VI02)
	NOP                            	sq VF13,302(VI02)
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	fcand VI01,262143
	NOP                            	iadd VI10,VI01,VI00
	NOP                            	fcor VI01,16773054
	NOP                            	NOP
	NOP                            	ibne VI01,VI00,clipSkip
	NOP                            	NOP
	NOP                            	fcor VI01,16768893
	NOP                            	NOP
	NOP                            	ibne VI01,VI00,clipSkip
	NOP                            	NOP
	NOP                            	fcor VI01,16760571
	NOP                            	NOP
	NOP                            	ibne VI01,VI00,clipSkip
	NOP                            	NOP
	NOP                            	fcor VI01,16743927
	NOP                            	NOP
	NOP                            	ibne VI01,VI00,clipSkip
	NOP                            	NOP
	NOP                            	fcor VI01,16644063
	NOP                            	NOP
	NOP                            	ibne VI01,VI00,clipSkip
	NOP                            	NOP
	NOP                            	iaddiu VI11,VI00,3
	NOP                            	iaddiu VI12,VI02,296
	NOP                            	ibeq VI10,VI00,clipProj
	NOP                            	iaddiu VI13,VI02,323
	NOP                            	iaddiu VI15,VI00,1014
	NOP                            	fcand VI01,133152
	NOP                            	isw.x VI01,382(VI02)
	NOP                            	fcand VI01,137313
	NOP                            	isw.x VI01,383(VI02)
	NOP                            	fcand VI01,141474
	NOP                            	isw.x VI01,384(VI02)
	NOP                            	fcand VI01,149796
	NOP                            	isw.x VI01,385(VI02)
	NOP                            	fcand VI01,166440
	NOP                            	isw.x VI01,386(VI02)
clipPlane:
	NOP                            	iadd VI01,VI15,VI02
	NOP                            	ilw.x VI01,-632(VI01)
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	ibeq VI01,VI00,clipNext
	NOP                            	NOP
	NOP                            	lq VF30,0(VI15)
	NOP                            	iadd VI01,VI11,VI11
	NOP                            	iadd VI01,VI01,VI11
	NOP                            	iadd VI01,VI01,VI12
	NOP                            	iadd VI06,VI12,VI00
	NOP                            	lq VF10,-3(VI01)
	NOP                            	lq VF11,-2(VI01)
	NOP                            	lq VF12,-1(VI01)
	mul VF19,VF10,VF30             	NOP
	adday.x ACC,VF19,VF19y         	NOP
	maddaz.x ACC,VF29,VF19z        	NOP
	maddw.x VF13,VF29,VF19w        	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	fmand VI14,VI09
	NOP                            	iadd VI07,VI13,VI00
	NOP                            	iaddiu VI10,VI00,0
clipEdge:
	NOP                            	lq VF14,0(VI06)
	NOP                            	lq VF15,1(VI06)
	NOP                            	lq VF16,2(VI06)
	mul VF19,VF14,VF30             	NOP
	adday.x ACC,VF19,VF19y         	NOP
	maddaz.x ACC,VF29,VF19z        	NOP
	maddw.x VF17,VF29,VF19w        	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	fmand VI01,VI09
	NOP                            	NOP
	sub.x VF18,VF13,VF17           	ibeq VI01,VI14,clipNoCross
	NOP                            	NOP
	sub.x VF19,VF17,VF13           	ibne VI14,VI00,clipFromCur
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	div Q,VF13x,VF18x
	sub VF19,VF14,VF10             	waitq
	mulaw ACC,VF10,VF00w           	NOP
	maddq VF20,VF19,Q              	NOP
	sub VF19,VF15,VF11             	NOP
	mulaw ACC,VF11,VF00w           	NOP
	maddq VF21,VF19,Q              	sq VF20,0(VI07)
	sub VF19,VF16,VF12             	NOP
	mulaw ACC,VF12,VF00w           	NOP
	maddq VF22,VF19,Q              	sq VF21,1(VI07)
	NOP                            	b clipStored
	NOP                            	NOP
clipFromCur:
	NOP                            	NOP
	NOP                            	div Q,VF17x,VF19x
	sub VF19,VF10,VF14             	waitq
	mulaw ACC,VF14,VF00w           	NOP
	maddq VF20,VF19,Q              	NOP
	sub VF19,VF11,VF15             	NOP
	mulaw ACC,VF15,VF00w           	NOP
	maddq VF21,VF19,Q              	sq VF20,0(VI07)
	sub VF19,VF12,VF16             	NOP
	mulaw ACC,VF16,VF00w           	NOP
	maddq VF22,VF19,Q              	sq VF21,1(VI07)
clipStored:
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	sq VF22,2(VI07)
	NOP                            	iaddiu VI07,VI07,3
	NOP                            	iaddiu VI10,VI10,1
clipNoCross:
	NOP                            	ibne VI01,VI00,clipCurOut
	NOP                            	NOP
	NOP                            	sq VF14,0(VI07)
	NOP                            	sq VF15,1(VI07)
	NOP                            	sq VF16,2(VI07)
	NOP                            	iaddiu VI07,VI07,3
	NOP                            	iaddiu VI10,VI10,1
clipCurOut:
	NOP                            	move VF10,VF14
	NOP                            	move VF11,VF15
	NOP                            	move VF12,VF16
	NOP                            	move VF13,VF17
	NOP                            	iadd VI14,VI01,VI00
	NOP                            	iaddiu VI06,VI06,3
	NOP                            	isubiu VI11,VI11,1
	NOP                            	NOP
	NOP                            	ibne VI11,VI00,clipEdge
	NOP                            	NOP
	NOP                            	iadd VI11,VI10,VI00
	NOP                            	iadd VI01,VI12,VI00
	NOP                            	iadd VI12,VI13,VI00
	NOP                            	iadd VI13,VI01,VI00
	NOP                            	isubiu VI01,VI11,3
	NOP                            	NOP
	NOP                            	ibltz VI01,clipSkip
	NOP                            	NOP
clipNext:
	NOP                            	iaddiu VI15,VI15,1
	NOP                            	iaddiu VI01,VI00,1015
	NOP                            	NOP
	NOP                            	ibne VI15,VI01,clipNext2
	NOP                            	ilw.x VI01,382(VI02)
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	ibeq VI01,VI00,clipNext2
	NOP                            	iadd VI06,VI12,VI00
	NOP                            	iadd VI10,VI11,VI00
clipRe:
	NOP                            	lq VF10,0(VI06)
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	mul.xyz VF16,VF10,VF07         	NOP
	mulz.w VF17,VF00,VF10z         	NOP
	NOP                            	NOP
	NOP                            	NOP
	add.xyz VF16,VF16,VF08         	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	clipw.xyz VF16xyz,VF17w        	isubiu VI10,VI10,1
	NOP                            	iaddiu VI06,VI06,3
	NOP                            	NOP
	NOP                            	ibne VI10,VI00,clipRe
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	fcand VI01,266305
	NOP                            	isw.x VI01,383(VI02)
	NOP                            	fcand VI01,532610
	NOP                            	isw.x VI01,384(VI02)
	NOP                            	fcand VI01,1065220
	NOP                            	isw.x VI01,385(VI02)
	NOP                            	fcand VI01,2130440
	NOP                            	isw.x VI01,386(VI02)
clipNext2:
