	mula.xyz ACC,VF21,VF07         	NOP
	max.w VF24,VF24,VF07           	NOP
	maddw.xyz VF29,VF08,VF00w      	NOP
	mulq.xy VF30,VF22,Q            	waitq
	addq.z VF30,VF00,Q             	NOP
	mulaw.xyz ACC,VF06,VF00w       	NOP
	sub.xyz VF31,VF26,VF25         	NOP
	max.w VF25,VF25,VF07           	NOP
	madd.xyz VF24,VF30,VF05        	NOP
	mula.xyz ACC,VF22,VF07         	NOP
	maddw.xyz VF11,VF08,VF00w      	NOP
	max.w VF26,VF26,VF07           	NOP
	sub.xyz VF17,VF24,VF25         	NOP
	clipw.xyz VF28xyz,VF20w        	NOP
	mini.w VF24,VF24,VF08          	NOP
	clipw.xyz VF29xyz,VF21w        	NOP
	opmula.xyz ACC,VF17,VF31       	NOP
	clipw.xyz VF11xyz,VF22w        	NOP
	opmsub.xyz VF18,VF31,VF17      	NOP
	itof0.xy VF16,VF16             	NOP
	mini.w VF25,VF25,VF08          	NOP
	mini.w VF26,VF26,VF08          	fcand VI01,262143
	ftoi4 VF19,VF24                	fmand VI07,VI05
	mulq.xy VF16,VF16,Q            	ior VI10,VI01,VI07
	mulq.z VF16,VF09,Q             	iaddiu VI10,VI10,0x7fff
	ftoi4 VF12,VF25                	iand VI10,VI10,VI09
	ftoi4 VF14,VF26                	mtir VI11,VF19w
	NOP                            	sq VF19,9(VI08)
	NOP                            	ior VI10,VI10,VI11
	NOP                            	sq VF12,3(VI08)
	NOP                            	sq VF14,6(VI08)
	NOP                            	sq VF16,7(VI08)
	NOP                            	isw.w VI10,9(VI08)
	NOP                            	NOP
	NOP                            	xgkick VI08
	NOP                            	isub VI08,VI06,VI08
	NOP                            	ibne VI04,VI00,mapTri
	NOP                            	NOP
	NOP[E]                         	NOP
	NOP                            	NOP
