	ftoi0 VF12,VF12                	NOP
	NOP                            	NOP
	NOP                            	NOP
	add.w VF20,VF20,VF06           	NOP
	NOP                            	NOP
	NOP                            	NOP
	NOP                            	NOP
	max.w VF20,VF20,VF07           	waitq
